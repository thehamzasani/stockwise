{
  "identifier": "default",
  "description": "StockWise default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:allow-execute", "sql:allow-select", "sql:allow-load", "sql:allow-close",
    "dialog:allow-save", "dialog:allow-open",
    "fs:allow-write-file", "fs:allow-read-file",
    { "identifier": "fs:allow-copy-file", "allow": [{ "path": "$APPCONFIG" }, { "path": "$APPCONFIG/**" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "$APPCONFIG/**" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$APPCONFIG/**" }] },
    "shell:allow-open"
  ]
}